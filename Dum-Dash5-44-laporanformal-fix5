    // ── Download PPT dari data yang sudah di-preview ──────────────────────────────
    async function downloadPPTFromData() {
        const d = window._pptData;
        if (!d) return;

        const pptx = new PptxGenJS();
        pptx.layout = 'LAYOUT_WIDE';
        const DARK='0A1628', WHITE='FFFFFF', BLUE='2563EB', GREEN='10B981';
        const PURPLE='7C3AED', RED='DC2626', AMBER='D97706', SLATE='64748B', LIGHT='F8FAFC';
        const F = 'Inter';
        const logoData = d.logoSrc ? d.logoSrc.split(',')[1] : null;

        const addSlideHeader = (slide, title, sub) => {
            slide.addShape(pptx.ShapeType.rect, {x:0.3,y:0.1,w:11.7,h:0.65,fill:{color:WHITE},line:{color:'0F172A',width:2}});
            if(logoData) slide.addImage({data:'image/png;base64,'+logoData, x:0.42,y:0.12,w:0.5,h:0.5});
            slide.addShape(pptx.ShapeType.rect, {x:1.06,y:0.18,w:0.03,h:0.35,fill:{color:'E2E8F0'},line:{color:'E2E8F0'}});
            slide.addText(title, {x:1.18,y:0.18,w:7,h:0.35,fontSize:13,bold:true,color:'0F172A',fontFace:F});
            slide.addText(sub, {x:8.0,y:0.2,w:3.7,h:0.3,fontSize:10,color:SLATE,align:'right',fontFace:F});
        };

        // Slide 1
        const s1 = pptx.addSlide();
        addSlideHeader(s1, 'LAPORAN PERJALANAN DINAS', d.periodeStr);
        s1.addText('RINGKASAN EKSEKUTIF', {x:0.4,y:0.9,w:5,h:0.25,fontSize:9,bold:true,color:SLATE,fontFace:F});
        s1.addShape(pptx.ShapeType.line, {x:0.4,y:1.15,w:11.8,h:0,line:{color:'E2E8F0',width:1}});

        let tLead2=0, cLead2=0;
        filteredData.forEach(dv=>{ const v=Number(dv.LeadTime); if(!isNaN(v)&&v>0){tLead2+=v;cLead2++;} });
        const avgLead2 = cLead2>0?(tLead2/cLead2).toFixed(1):'0';

        const metrics = [
            {label:'TOTAL BIAYA', val:d.idrStr, color:BLUE},
            {label:'TOTAL TRIP', val:d.n+' trip', color:GREEN},
            {label:'AVG DAY/TRIP', val:d.avgDur+' hari', color:PURPLE},
            {label:'LEAD TIME', val:avgLead2+' hari', color:AMBER},
            {label:'TOTAL EMISI', val:fmtNum(d.tE)+' kg', color:RED},
        ];
        metrics.forEach((m,i) => {
            const x=0.4+i*2.42;
            s1.addShape(pptx.ShapeType.rect, {x,y:1.22,w:2.25,h:1.1,fill:{color:LIGHT},line:{color:'E2E8F0',width:1}});
            s1.addShape(pptx.ShapeType.rect, {x,y:1.22,w:2.25,h:0.07,fill:{color:m.color},line:{color:m.color}});
            s1.addText(m.label, {x:x+0.1,y:1.35,w:2.0,h:0.22,fontSize:8,bold:true,color:SLATE,fontFace:F});
            s1.addText(m.val, {x:x+0.1,y:1.6,w:2.0,h:0.5,fontSize:11,bold:true,color:m.color,fontFace:F});
        });

        s1.addText('GRAFIK', {x:0.4,y:2.45,w:3,h:0.22,fontSize:9,bold:true,color:SLATE,fontFace:F});
        s1.addShape(pptx.ShapeType.line, {x:0.4,y:2.68,w:11.8,h:0,line:{color:'E2E8F0',width:1}});
        if(d.trendImgSrc) s1.addImage({data:d.trendImgSrc, x:0.4,y:2.75,w:7.3,h:4.2});
        else { s1.addShape(pptx.ShapeType.rect, {x:0.4,y:2.75,w:7.3,h:4.2,fill:{color:LIGHT},line:{color:'E2E8F0',width:1}}); s1.addText('Grafik Trend Biaya',{x:0.4,y:4.5,w:7.3,h:0.4,fontSize:10,color:SLATE,align:'center',fontFace:F}); }
        if(d.donutImgSrc) s1.addImage({data:d.donutImgSrc, x:7.9,y:2.75,w:3.9,h:4.2});
        else { s1.addShape(pptx.ShapeType.rect, {x:7.9,y:2.75,w:3.9,h:4.2,fill:{color:LIGHT},line:{color:'E2E8F0',width:1}}); s1.addText('Donut Emisi',{x:7.9,y:4.5,w:3.9,h:0.4,fontSize:10,color:SLATE,align:'center',fontFace:F}); }
        s1.addText('1 / 3', {x:11.5,y:7.3,w:0.8,h:0.2,fontSize:8,color:SLATE,align:'right',fontFace:F});

