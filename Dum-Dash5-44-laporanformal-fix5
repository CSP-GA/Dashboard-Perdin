        s3.addText('UMUM', {x:0.45, y:0.95, w:3, h:0.25, fontSize:9, bold:true, color:BLUE, fontFace:F});
        s3.addText(umumTxt, {x:0.45, y:1.25, w:11.3, h:1.9, fontSize:10, color:'334155', fontFace:F, valign:'top', wrap:true});

        // ── Baris 2 kiri: Proyek (x=0.2, w=5.75) ────────────────────────────
        s3.addShape(pptx.ShapeType.rect, {x:0.2, y:3.55, w:5.75, h:3.5, fill:{color:'F0FDF4'}, line:{color:'16A34A', width:2}});
        s3.addShape(pptx.ShapeType.rect, {x:0.2, y:3.55, w:0.12, h:3.5, fill:{color:'16A34A'}, line:{color:'16A34A'}});
        s3.addText('KEGIATAN PROYEK', {x:0.45, y:3.62, w:5.3, h:0.25, fontSize:9, bold:true, color:'16A34A', fontFace:F});

        const proyekList3 = parsed3 && parsed3.proyekList ? parsed3.proyekList : [];
        if (proyekList3.length > 0) {
            const proyekBullets = proyekList3.slice(0, 8).map(function(p) {
                return { text: (p.nama || '-'), options: { bullet: {code:'25CF'}, fontSize:10, color:'134E2C', bold:true, fontFace:F } };
            });
            // Tambah trip count sebagai sub-bullet
            const proyekRows = [];
            proyekList3.slice(0, 8).forEach(function(p) {
                proyekRows.push({ text: (p.nama || '-'), options: { bullet: {code:'25CF'}, fontSize:10, color:'134E2C', bold:true, fontFace:F, paraSpaceAfter:2 } });
                proyekRows.push({ text: (p.divisi || '') + '  •  ' + (p.trip || 0) + ' trip', options: { bullet: false, fontSize:9, color:'64748B', fontFace:F, indentLevel:1, paraSpaceAfter:4 } });
            });
            s3.addText(proyekRows, {x:0.45, y:3.95, w:5.35, h:2.9, fontFace:F, valign:'top'});
        } else {
