    // ── Generate Narasi AI ────────────────────────────────────────────────────────
    async function generateNarasi() {
        const dateVal = document.getElementById('dateInput').value;
        const selDate = dateVal ? new Date(dateVal) : new Date();
        const currentKey = getNarasiFilterKey();
        const payload = buildNarasiPayload(filteredData, currentMode, selDate);

        callGASNarasi(payload)
            .then(function(text) {
                const parsed = parseNarasiResponse(text, payload);
                narasiCache = {
                    filterKey: currentKey,
                    _parsed: parsed,
                    umum: parsed.umum,
                    proyek: (parsed.proyekList||[]).map(p=>p.nama).join(', '),
                    emisi: parsed.sustPara
                };
                renderNarasiCards_Dashboard(parsed, payload);
            })
            .catch(function(e) {
                const isOverload = e.message && (e.message.includes('529') || e.message.includes('Timeout'));
                const msg = isOverload
                    ? '&#9888; Server AI sedang sibuk. Coba lagi dalam beberapa menit.'
                    : '&#9888; Gagal memuat narasi: ' + e.message;
                const loading = document.getElementById('narasi-loading');
                if (loading) loading.innerHTML = '<div style="color:#dc2626;font-size:12px;padding:8px;font-weight:600;">' + msg + '</div>';
                const umumEl = document.getElementById('narasi-umum');
                if (umumEl) umumEl.innerHTML = '<div style="color:#dc2626;font-size:12px;padding:8px;font-weight:600;">' + msg + '</div>';
                setNarasiLoading(false);
            });
    }

    
    function callGASNarasi(payload) {
        return new Promise((resolve, reject) => {
            if (typeof google === 'undefined' || !google.script) {
                reject(new Error('Tidak berjalan di Google Apps Script'));
                return;
            }
            const timer = setTimeout(() => {
                reject(new Error('Timeout — server AI tidak merespons. Coba lagi.'));
            }, 45000);
            google.script.run
                .withSuccessHandler(text => { clearTimeout(timer); resolve(text); })
                .withFailureHandler(err  => { clearTimeout(timer); reject(new Error(err.message || 'GAS Error')); })
                .generateNarasiAI(payload);
        });
    }

    function renderNarasiCards_Dashboard(parsed, payload) {
        const { umum_html, proj_html, moda_html, sust_html } = renderNarasiCards(parsed, payload);

        const umumEl  = document.getElementById('narasi-umum');
        const proyekEl = document.getElementById('narasi-proyek');
        const emisiEl = document.getElementById('narasi-emisi');
        if (umumEl)  umumEl.innerHTML  = umum_html;
        if (proyekEl) proyekEl.innerHTML = proj_html;
        if (emisiEl) emisiEl.innerHTML = sust_html + moda_html;

        const loading = document.getElementById('narasi-loading');
        if (loading) loading.style.display = 'none';
        const el = document.getElementById('narasi-content');
        if (el) el.style.display = 'block';
        const section = document.getElementById('narasi-ai-section');
        if (section) section.style.display = 'block';
        setNarasiLoading(false);
    }

    
