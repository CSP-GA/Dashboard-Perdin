ottom:0.5px solid #dbeafe;line-height:1.5;">' + (d.Tujuan||'-') + '</div>\n                        <!-- Baris 2: Transportasi -->\n                        <div style="font-size:10px;font-weight:700;color:#93c5fd;text-transform:uppercase;letter-spacing:0.06em;padding:7px 14px 7px 0;border-bottom:0.5px solid #dbeafe;display:flex;align-items:center;">Transportasi</div>\n                        <div style="font-size:13px;font-weight:600;color:#1e293b;padding:7px 0;border-bottom:0.5px solid #dbeafe;">' + (d.ModaBerangkat||'-') + ' &nbsp;›&nbsp; ' + (d.ModaPulang||'-') + '</div>\n                        <!-- Baris 3: Emisi -->\n                        <div style="font-size:10px;font-weight:700;color:#93c5fd;text-transform:uppercase;letter-spacing:0.06em;padding:7px 14px 7px 0;display:flex;align-items:center;">Emisi</div>\n                        <div style="font-size:13px;font-weight:700;color:#dc2626;padding:7px 0;">' + (fmtEmisi(d.EmisiBerangkat||0)) + ' + ' + (fmtEmisi(d.EmisiPulang||0)) + ' = ' + (fmtEmisi(d.Emisi||0)) + ' kg CO₂</div>\n                    </div>\n                </td>\n            </tr>';
