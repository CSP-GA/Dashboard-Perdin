    function updateTrendChart(colorCode) {
        const canvasEl = document.getElementById('trendChart');
        if (!canvasEl) { console.warn('[TREND] canvas not found'); return; }
        const ctx = canvasEl.getContext('2d');
        if (!ctx) { console.warn('[TREND] ctx not found'); return; }
        const selDate = new Date(document.getElementById('dateInput').value);
        const selDiv  = document.getElementById('filterDivisi').value;
        const colors  = { blue:'#2563eb', green:'#10b981', navy:'#0f4c81', orange:'#f59e0b', yellow:'#fbbf24', purple:'#7c3aed', red:'#dc2626' };
        const color   = colors[colorCode] || '#2563eb';

        const BULAN = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];

        // trendSource: pakai filteredData yang sudah include quick filter
        const trendSource = filteredData;

        let labels, sums, counts;

        if (currentMode === 'ytd') {
            // YTD: sumbu X = bulan Jan s/d bulan dipilih
            const maxMonth = selDate.getMonth();
            labels = BULAN.slice(0, maxMonth + 1);
            sums   = new Array(maxMonth + 1).fill(0);
            counts = new Array(maxMonth + 1).fill(0);

            trendSource.forEach(d => {
                const arrDate = new Date(d.Arrival);
                if (arrDate.getFullYear() !== selDate.getFullYear()) return;
                if (arrDate > selDate) return;
                const idx = arrDate.getMonth();
                if (idx > maxMonth) return;
                accumulateMetric(sums, counts, idx, d);
            });
        } else {
            // Daily / MTD: sumbu X = hari dalam bulan
            const lastDay = new Date(selDate.getFullYear(), selDate.getMonth()+1, 0).getDate();
            labels = Array.from({ length: lastDay }, (_, i) => i+1);
            sums   = new Array(lastDay).fill(0);
            counts = new Array(lastDay).fill(0);

            trendSource.forEach(d => {
                const arrDate = new Date(d.Arrival);
                if (arrDate.getMonth() !== selDate.getMonth() || arrDate.getFullYear() !== selDate.getFullYear()) return;
                if (arrDate > selDate) return;
                const idx = arrDate.getDate() - 1;
                accumulateMetric(sums, counts, idx, d);
            });
        }

        const useAvg = ['Durasi','Lead','SLA','LeadSLA'].includes(activeMetric);
        const dataPoints = sums.map((s,i) => useAvg ? (counts[i]>0 ? parseFloat((s/counts[i]).toFixed(2)) : null) : (s>0 ? parseFloat(s.toFixed(2)) : 0));

        const metricLabels = { Biaya:'Total Biaya', Trip:'Jumlah Trip', Durasi:'Avg Day/Trip (Hari)', LeadSLA:'Lead Time & SLA Approve (Hari)', Lead:'Avg Lead Time (Hari)', SLA:'Avg SLA Approve (Hari)', Emisi:'Total Emisi (KG CO₂)' };
        const modeLabel    = { daily:'Harian', mtd:'MTD', ytd:'YTD per Bulan' };
        document.getElementById('trendTitle').innerText    = 'Trend: ' + (metricLabels[activeMetric]||activeMetric);
        const subEl2 = document.getElementById('trendSubtitle'); if(subEl2){ subEl2.style.display='block'; } const quickLabel = quickFilterType === 'traveler' ? ' · ' + quickFilterValue : quickFilterType === 'kota' ? ' · ' + quickFilterValue : '';
        document.getElementById('trendSubtitle').innerText = selDate.toLocaleDateString('id-ID',{month:'long',year:'numeric'}) + ' · ' + (modeLabel[currentMode]||'') + (selDiv ? ' · '+selDiv.toUpperCase() : ' · Semua Divisi') + quickLabel;

        if (trendChart) trendChart.destroy();

        // ── Khusus Biaya: dual axis Bar IDR + Line USD ────────────────────────────
        if (activeMetric === 'Biaya') {
            const sumsUSD = new Array(sums.length).fill(0);
            const srcData = allData;
            srcData.forEach(d => {
                const arrDate = new Date(d.Arrival);
                let idx = -1;
                if (currentMode === 'ytd') {
                    if (arrDate.getFullYear() !== selDate.getFullYear() || arrDate > selDate) return;
                    if (selDiv !== '' && d.Divisi !== selDiv) return;
                    idx = arrDate.getMonth();
                    if (idx > selDate.getMonth()) return;
                } else {
                    if (arrDate.getMonth() !== selDate.getMonth() || arrDate.getFullYear() !== selDate.getFullYear()) return;
                    if (currentMode === 'daily' && arrDate.toDateString() !== selDate.toDateString()) return;
                    if (currentMode === 'mtd' && arrDate > selDate) return;
                    if (selDiv !== '' && d.Divisi !== selDiv) return;
                    idx = arrDate.getDate() - 1;
                }
                if (idx >= 0) sumsUSD[idx] += Number(d.BiayaUSD||0);
            });

            const hasUSD = sumsUSD.some(v => v > 0);

            trendChart = new Chart(ctx, {
                data: {
                    labels,
                    datasets: [
                        {
                            type: 'bar',
                            label: 'IDR',
                            data: dataPoints,
                            backgroundColor: '#2563ebcc',
                            borderRadius: 4,
                            borderSkipped: false,
                            yAxisID: 'yIDR',
                            order: 2
                        },
                        ...(hasUSD ? [{
                            type: 'line',
                            label: 'USD',
                            data: sumsUSD.map(v => v > 0 ? v : null),
                            borderColor: '#f59e0b',
                            backgroundColor: '#f59e0b22',
                            pointBackgroundColor: '#f59e0b',
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            borderWidth: 2,
                            fill: false,
                            tension: 0.3,
                            yAxisID: 'yUSD',
                            order: 1,
                            spanGaps: false
                        }] : [])
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false, layout: { padding: { top:8, right:8, bottom:0, left:8 } },
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: {
                            title: ctx => currentMode==='ytd' ? BULAN[ctx[0].dataIndex] : 'Tgl '+ctx[0].label,
                            label: ctx => ctx.dataset.label === 'USD'
                                ? '$ ' + ctx.raw
                                : 'Rp ' + (ctx.raw >= 1000 ? (ctx.raw/1000).toFixed(2)+' Miliar' : (ctx.raw||0).toFixed(1)+' Juta') + ' (DN)'
                        }}
                    },
                    scales: {
                        x: { grid:{display:false}, ticks:{font:{size:11,weight:'700'},color:'#94a3b8'} },
                        yIDR: { beginAtZero:true, position:'left', grid:{color:'#f1f5f9'}, ticks:{font:{size:11,weight:'700'},color:'#2563eb', callback: v => {
                            if (v >= 1000) return (v/1000).toFixed(0) + ' M Juta';
                            return v + ' Juta';
                        }}},
                        ...(hasUSD ? { yUSD: { beginAtZero:true, position:'right', grid:{display:false}, ticks:{font:{size:11,weight:'700'},color:'#f59e0b', callback:v=>'$'+v} } } : {})
                    }
                }
            });

            // Tambah legend manual
            document.getElementById('trendSubtitle').innerHTML =
                selDate.toLocaleDateString('id-ID',{month:'long',year:'numeric'}) + ' · ' + (modeLabel[currentMode]||'') + (selDiv ? ' · '+selDiv.toUpperCase() : ' · Semua Divisi') +
                ' &nbsp;<span style="display:inline-flex;align-items:center;gap:4px;font-size:10px;"><span style="width:8px;height:8px;border-radius:2px;background:#2563eb;display:inline-block;"></span>IDR</span>' +
                (hasUSD ? ' &nbsp;<span style="display:inline-flex;align-items:center;gap:4px;font-size:10px;"><span style="width:12px;height:2px;background:#f59e0b;display:inline-block;border-radius:2px;"></span>USD</span>' : '');
            return;
        }

        // ── Khusus LeadSLA: Bar Lead Time + Line SLA Approve ─────────────────────
        if (activeMetric === 'LeadSLA') {
            // Hitung SLA per tanggal terpisah
            const sumsSLA   = new Array(sums.length).fill(0);
            const countsSLA = new Array(sums.length).fill(0);
            const approverMap = {}; // tanggal → [nama approver SLA lambat]

            trendSource.forEach(d => {
                const arrDate = new Date(d.Arrival);
                let i = -1;
                if (currentMode === 'ytd') {
                    if (arrDate.getFullYear() !== selDate.getFullYear() || arrDate > selDate) return;
                    i = arrDate.getMonth();
                } else {
                    if (arrDate.getMonth() !== selDate.getMonth() || arrDate.getFullYear() !== selDate.getFullYear() || arrDate > selDate) return;
                    i = arrDate.getDate() - 1;
                }
                if (i < 0) return;
                const v = Number(d.SLA);
                if (!isNaN(v)) {
                    sumsSLA[i] += v;
                    countsSLA[i]++;
                    // Kumpulkan approver yang SLA lambat (> 1 hari)
                    if (v > (8/24) && d.Approver) {
                        if (!approverMap[i]) approverMap[i] = [];
                        if (!approverMap[i].includes(d.Approver)) approverMap[i].push(d.Approver);
                    }
                }
            });

            const slaPoints = sumsSLA.map((s,i) => countsSLA[i] > 0 ? parseFloat((s/countsSLA[i]).toFixed(2)) : null);

            // Warna bar — pakai LeadStatus per tanggal dari data
            const statusPerDay = {};
            trendSource.forEach(d => {
                const arrDate = new Date(d.Arrival);
                const i = currentMode === 'ytd' ? arrDate.getMonth() : arrDate.getDate()-1;
                if (!statusPerDay[i]) statusPerDay[i] = [];
                statusPerDay[i].push(d.LeadStatus || 'normal');
            });

            // Ganti 0 dengan nilai negatif kecil untuk sangat_mepet — tampil di bawah garis
            const barDisplayPoints = dataPoints.map((lead, i) => {
                const statuses = statusPerDay[i] || [];
                if (statuses.includes('sangat_mepet') && (!lead || lead === 0)) return -0.05;
                return lead;
            });

            const barColors = barDisplayPoints.map((lead, i) => {
                const sla = slaPoints[i];
                if (lead === null || lead === undefined) return 'transparent';
                const lambat = sla !== null && sla > (8/24); // > 8 jam
                const statuses = statusPerDay[i] || [];
                const hasSangatMepet = statuses.includes('sangat_mepet');
                const hasMepet       = statuses.includes('mepet');
                const hasInfo        = statuses.includes('info');

                if ((hasSangatMepet || hasMepet) && lambat) return '#ef4444';
                if (hasSangatMepet || hasMepet) return '#f97316';
                if (lambat)          return '#f97316';
                if (hasInfo)         return '#fbbf24';
                return '#10b981';
            });

            if (trendChart) trendChart.destroy();
            trendChart = new Chart(ctx, {
                data: {
                    labels,
                    datasets: [
                        {
                            type: 'bar',
                            label: 'Lead Time',
                            data: barDisplayPoints,
                            backgroundColor: barColors,
                            borderWidth: 0,
                            borderRadius: 4,
                            borderSkipped: false,
                            order: 2
                        },
                        {
                            type: 'line',
                            label: 'SLA Approve',
                            data: slaPoints,
                            borderColor: '#8b5cf6',
                            backgroundColor: 'transparent',
                            borderWidth: 2,
                            pointRadius: 3,
                            pointBackgroundColor: slaPoints.map(v => v !== null && v > 1 ? '#f97316' : '#8b5cf6'),
                            pointBorderColor: 'white',
                            pointBorderWidth: 1,
                            tension: 0.3,
                            spanGaps: false,
                            order: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: { padding: 0 },
                    onClick: (evt, elements) => {
                        if (elements.length > 0) showLeadSLADetail(elements[0].index);
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                title: ctx => currentMode === 'ytd' ? BULAN[ctx[0].dataIndex] : 'Tgl ' + ctx[0].label,
                                label: ctx => {
                                    const i = ctx.dataIndex;
                                    if (ctx.datasetIndex === 0) {
                                        const v = ctx.raw;
                                        if (!v) return ' Lead Time: no data';
                                        const jam = v < 1 ? ' (~' + Math.round(v*9) + ' jam kerja)' : '';
                                        return ' Lead Time: ' + v.toFixed(2) + ' hari kerja' + jam;
                                    }
                                    const v = ctx.raw;
                                    if (v === null) return ' SLA Approve: no data';
                                    const warn = v > (8/24) ? ' &#9888; lambat' : '';
                                    const appList = approverMap[i] || [];
                                    const appStr = appList.length > 0
                                        ? ' | Approver: ' + appList.slice(0,3).join(', ') + (appList.length > 3 ? ' +' + (appList.length-3) + ' lagi' : '')
                                        : '';
                                    return ' SLA Approve: ' + v.toFixed(2) + ' hari kerja' + warn + appStr;
                                }
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { font: { size: 11, weight: '700' }, color: '#94a3b8' } },
                        y: { min: -0.1, grid: { color: '#f8fafc' }, ticks: { font: { size: 10, weight: '700' }, color: '#94a3b8',
                            callback: function(val) { return val < 0 ? '' : val; }
                        }}
                    }
                }
            });

            setTimeout(() => { if (trendChart) trendChart.resize(); }, 50);

            // Legend subtitle
            document.getElementById('trendSubtitle').innerHTML =
                selDate.toLocaleDateString('id-ID',{month:'long',year:'numeric'}) + ' · ' + (modeLabel[currentMode]||'') +
                (selDiv ? ' · ' + selDiv.toUpperCase() : ' · Semua Divisi') + quickLabel +
                ' &nbsp;<span style="display:inline-flex;align-items:center;gap:4px;font-size:10px;"><span style="width:8px;height:8px;border-radius:2px;background:#10b981;display:inline-block;"></span>Normal</span>' +
                ' <span style="display:inline-flex;align-items:center;gap:4px;font-size:10px;"><span style="width:8px;height:8px;border-radius:2px;background:#fbbf24;display:inline-block;"></span>Mepet</span>' +
                ' <span style="display:inline-flex;align-items:center;gap:4px;font-size:10px;"><span style="width:8px;height:8px;border-radius:2px;background:#f97316;display:inline-block;"></span>Appv Lambat</span>' +
                ' <span style="display:inline-flex;align-items:center;gap:4px;font-size:10px;"><span style="width:8px;height:8px;border-radius:2px;background:#ef4444;display:inline-block;"></span>Keduanya</span>' +
                ' &nbsp;<span style="display:inline-flex;align-items:center;gap:4px;font-size:10px;"><span style="width:14px;height:2px;background:#8b5cf6;display:inline-block;border-radius:2px;"></span>SLA Line</span>';
            return;
        }

        trendChart = new Chart(ctx, {
            type: 'bar',
            data: { labels, datasets: [{ label: activeMetric, data: dataPoints, backgroundColor: color+'cc', borderColor: color, borderWidth:0, borderRadius:4, borderSkipped:false }] },
            options: {
                responsive:true, maintainAspectRatio:false,
                plugins: { legend:{ display:false }, tooltip:{ callbacks:{
                    title: ctx => currentMode==='ytd' ? BULAN[ctx[0].dataIndex] : 'Tgl '+ctx[0].label,
                    label: ctx => {
                        const v = ctx.raw;
                        if (v===null||v===undefined) return 'No data';
                        if (activeMetric==='Trip')  return v+' trip';
                        if (activeMetric==='Emisi') return fmtNum(v)+' kg CO₂';
                        return v.toFixed(2)+' hari';
                    }
                }}},
                scales: {
                    x: { grid:{ display:false }, ticks:{ font:{ size:10, weight:'700' }, color:'#94a3b8' } },
                    y: { beginAtZero:true, grid:{ color:'#f1f5f9' }, ticks:{ font:{ size:10, weight:'700' }, color:'#94a3b8' } }
                }
            }
        });
    }

        function showSameDayTrips() {
        // Pakai baseFilteredData — sudah terfilter periode+grup+divisi, tanpa quick filter
        const sameDayTrips = baseFilteredData.filter(d => d.LeadStatus === 'sangat_mepet');
        if (sameDayTrips.length === 0) return;

        const selDate = new Date(document.getElementById('dateInput').value);
        const BULAN = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
        const periodeLabel = BULAN[selDate.getMonth()] + ' ' + selDate.getFullYear();
        const pct = Math.round(sameDayTrips.length / baseFilteredData.length * 100);

        // Reuse leadSLAModal
        const modal  = document.getElementById('leadSLAModal');
        const title  = document.getElementById('leadSLAModalTitle');
        const sub    = document.getElementById('leadSLAModalSub');
        const body   = document.getElementById('leadSLAModalBody');

        title.innerText = 'Submit Hari yang Sama — ' + periodeLabel;
        sub.innerText   = sameDayTrips.length + ' trip · ' + pct + '% dari total ' + baseFilteredData.length + ' trip';

        // Inject rows langsung — reuse format showLeadSLADetail
        const fmtDT = function(ts) {
            if (!ts) return '-';
            const dt = new Date(ts);
            const days = ['Min','Sen','Sel','Rab','Kam','Jum','Sab'];
            return days[dt.getDay()] + ' ' + dt.getDate() + ' ' +
                ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'][dt.getMonth()] +
                ', ' + String(dt.getHours()).padStart(2,'0') + ':' + String(dt.getMinutes()).padStart(2,'0');
        };
        const fmtJamLocal = function(val) {
            if (val === null || val === undefined) return '-';
            const menit = Math.round(val * 1440);
            if (menit <= 0) return '< 1 Menit';
            if (menit < 60) return menit + ' Menit';
            const jam = Math.round(val * 24);
            return jam < 24 ? jam + ' Jam' : Math.round(val) + ' Hari';
        };

        body.innerHTML = sameDayTrips.map(function(d) {
            const lead = Number(d.LeadTime||0);
            const sla  = Number(d.SLA||0);
            const submitStr  = fmtDT(d.TglSubmit);
            const arrivalStr = fmtDT(d.Arrival);
            const approveStr = fmtDT(d.TglApprove);
            const tujuanTooltip = (d.Tujuan||'-').replace(/"/g, '&quot;');
            return '<tr style="border-bottom:0.5px solid #f1f5f9;">' +
                '<td style="padding:10px 14px;text-align:left;" title="' + tujuanTooltip + '">' +
                    '<div style="font-size:12px;font-weight:700;color:#0f172a;white-space:nowrap;">' + (d.Nama||'-') + '</div>' +
                    '<div style="font-size:10px;font-weight:600;color:#94a3b8;margin-top:2px;">' + (d.Divisi||'') + '</div>' +
                '</td>' +
                '<td style="padding:10px 14px;font-size:12px;color:#334155;text-align:left;white-space:nowrap;" title="' + tujuanTooltip + '">' + (d.Kota||'-') + '</td>' +
                '<td style="padding:8px 14px;text-align:center;">' +
                    '<div style="display:inline-block;border:2px solid #ef4444;border-radius:10px;padding:8px 16px;min-width:160px;">' +
                        '<div style="font-size:15px;font-weight:900;color:#ef4444;text-align:center;">Hari yang Sama</div>' +
                        '<div style="display:grid;grid-template-columns:70px 1fr;font-size:11px;color:#475569;margin-top:4px;white-space:nowrap;"><span style="font-weight:700;">Submit</span><span>: ' + submitStr + '</span></div>' +
                        '<div style="display:grid;grid-template-columns:70px 1fr;font-size:11px;color:#475569;margin-top:1px;white-space:nowrap;"><span style="font-weight:700;">Berangkat</span><span>: ' + arrivalStr + '</span></div>' +
                    '</div>' +
                '</td>' +
                '<td style="padding:8px 14px;text-align:center;">' +
                    '<div style="display:inline-block;border:' + (sla > (8/24) ? '2px solid #f97316' : 'none') + ';border-radius:10px;padding:8px 16px;min-width:160px;">' +
                        '<div style="font-size:15px;font-weight:900;color:' + (sla > (8/24) ? '#f97316' : '#8b5cf6') + ';text-align:center;">' + fmtJamLocal(sla) + '</div>' +
                        '<div style="display:grid;grid-template-columns:60px 1fr;font-size:11px;color:#475569;margin-top:4px;white-space:nowrap;"><span style="font-weight:700;">Submit</span><span>: ' + submitStr + '</span></div>' +
                        '<div style="display:grid;grid-template-columns:60px 1fr;font-size:11px;color:#475569;margin-top:1px;white-space:nowrap;"><span style="font-weight:700;">Approve</span><span>: ' + approveStr + '</span></div>' +
                    '</div>' +
                '</td>' +
                '<td style="padding:10px 14px;font-size:12px;color:#475569;text-align:left;white-space:nowrap;">' + (d.Approver||'-') + '</td>' +
                '</tr>';
        }).join('');

        document.body.style.overflow = 'hidden';
        modal.style.display = 'flex';
    }

        function showLeadSLADetail(dayIndex) {
        const selDate = new Date(document.getElementById('dateInput').value);
        const modal   = document.getElementById('leadSLAModal');
        const body    = document.getElementById('leadSLAModalBody');
        const title   = document.getElementById('leadSLAModalTitle');
        const sub     = document.getElementById('leadSLAModalSub');

        // Filter trip di hari/bulan tersebut
        const trips = filteredData.filter(d => {
            const arr = new Date(d.Arrival);
            if (currentMode === 'ytd') return arr.getMonth() === dayIndex && arr.getFullYear() === selDate.getFullYear();
            return arr.getDate()-1 === dayIndex && arr.getMonth() === selDate.getMonth() && arr.getFullYear() === selDate.getFullYear();
        });

        if (trips.length === 0) return;

        const BULAN = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
        const tglLabel = currentMode === 'ytd'
            ? BULAN[dayIndex] + ' ' + selDate.getFullYear()
            : dayIndex+1 + ' ' + BULAN[selDate.getMonth()] + ' ' + selDate.getFullYear();

        title.innerText = 'Detail Perjalanan — ' + tglLabel;
        sub.innerText   = trips.length + ' trip';

        const fmtDT = function(ts) {
            if (!ts) return '-';
            const dt = new Date(ts);
            const days = ['Min','Sen','Sel','Rab','Kam','Jum','Sab'];
            return days[dt.getDay()] + ' ' + dt.getDate() + ' ' +
                ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'][dt.getMonth()] +
                ', ' + String(dt.getHours()).padStart(2,'0') + ':' + String(dt.getMinutes()).padStart(2,'0');
        };
        const fmtJam = function(val) {
            if (val === null || val === undefined) return '-';
            const menit = Math.round(val * 1440);
            if (menit <= 0) return '< 1 Menit';
            if (menit < 60) return menit + ' Menit';
            const totalJam = val * 24;
            if (totalJam < 24) {
                const jam = Math.round(totalJam);
                return jam + ' Jam';
            }
            return Math.round(val) + ' Hari';
        };

        body.innerHTML = trips.map(function(d) {
            const lead = Number(d.LeadTime||0);
            const sla  = Number(d.SLA||0);

            // Lead time border & status
            var ls = d.LeadStatus || 'normal';
            var leadBorder = 'none';
            var leadValColor = '#0f172a';
            var leadStatusLabel = lead > 0 ? lead.toFixed(0) + ' Hari' : '0 Hari';
            var leadStatusNote  = '';
            if (ls === 'sangat_mepet') {
                leadBorder = '2px solid #ef4444'; leadValColor = '#ef4444';
                leadStatusNote = 'Hari yang sama';
            } else if (ls === 'mepet') {
                leadBorder = '2px solid #f97316'; leadValColor = '#f97316';
                leadStatusNote = 'Di luar jam kerja';
            } else if (ls === 'info') {
                leadBorder = '2px solid #fbbf24'; leadValColor = '#fbbf24';
                leadStatusNote = 'Di luar jam kerja';
            }
            
            // SLA border kondisi
            var slaBorder = 'none';
            var slaValColor = '#8b5cf6';
            if (sla > (8/24)) { slaBorder = '2px solid #f97316'; slaValColor = '#f97316'; }

            // Sub-info tanggal
            var submitStr  = d.TglSubmit  ? fmtDT(d.TglSubmit)  : '-';
            var approveStr = d.TglApprove ? fmtDT(d.TglApprove) : '-';
            var arrivalStr = d.Arrival    ? fmtDT(d.Arrival)     : '-';

            var tujuanTooltip = (d.Tujuan||'-').replace(/"/g, '&quot;');
            return '<tr style="border-bottom:0.5px solid #f1f5f9;">' +
                '<td style="padding:10px 14px;text-align:left;" title="' + tujuanTooltip + '">' +
                    '<div style="font-size:12px;font-weight:700;color:#0f172a;white-space:nowrap;cursor:default;">' + (d.Nama||'-') + '</div>' +
                    '<div style="font-size:10px;font-weight:600;color:#94a3b8;margin-top:2px;">' + (d.Divisi||'') + '</div>' +
                '</td>' +
                '<td style="padding:10px 14px;font-size:12px;color:#334155;text-align:left;white-space:nowrap;" title="' + tujuanTooltip + '">' + (d.Kota||'-') + '</td>' +
                '<td style="padding:8px 20px;text-align:center;vertical-align:middle;">' +
                    '<div style="display:inline-block;border:' + leadBorder + ';border-radius:10px;padding:8px 16px;min-width:160px;">' +
                        '<div style="font-size:15px;font-weight:900;color:' + leadValColor + ';text-align:center;">' + leadStatusLabel + '</div>' +
                        (leadStatusNote ? '<div style="font-size:10px;font-weight:700;color:' + leadValColor + ';text-align:center;margin-bottom:4px;">' + leadStatusNote + '</div>' : '<div style="margin-bottom:6px;"></div>') +
                        '<div style="display:grid;grid-template-columns:70px 1fr;font-size:11px;color:#475569;margin-top:2px;white-space:nowrap;"><span style="font-weight:700;">Submit</span><span>: ' + submitStr + '</span></div>' +
                        '<div style="display:grid;grid-template-columns:70px 1fr;font-size:11px;color:#475569;margin-top:1px;white-space:nowrap;"><span style="font-weight:700;">Berangkat</span><span>: ' + arrivalStr + '</span></div>' +
                    '</div>' +
                '</td>' +
                '<td style="padding:8px 20px;text-align:center;vertical-align:middle;">' +
                    '<div style="display:inline-block;border:' + slaBorder + ';border-radius:10px;padding:8px 16px;min-width:160px;">' +
                        '<div style="font-size:15px;font-weight:900;color:' + slaValColor + ';text-align:center;margin-bottom:6px;">' + (d.SLAAnomali ? '<span style="font-size:11px;color:#ef4444;">&#9888; Approve sebelum Submit</span>' : fmtJam(sla)) + '</div>' +
                        '<div style="display:grid;grid-template-columns:60px 1fr;font-size:11px;color:#475569;margin-top:2px;white-space:nowrap;"><span style="font-weight:700;">Submit</span><span>: ' + submitStr + '</span></div>' +
                        '<div style="display:grid;grid-template-columns:60px 1fr;font-size:11px;color:#475569;margin-top:1px;white-space:nowrap;"><span style="font-weight:700;">Approve</span><span>: ' + approveStr + '</span></div>' +
                    '</div>' +
                '</td>' +
                '<td style="padding:10px 14px;font-size:12px;color:#475569;text-align:left;white-space:nowrap;">' + (d.Approver||'-') + '</td>' +
                '</tr>';
        }).join('');

        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

        function accumulateMetric(sums, counts, idx, d) {
        if (activeMetric === 'Biaya') { sums[idx] += Number(d.BiayaIDR||0)/1000000; counts[idx]++; }
        else if (activeMetric === 'Trip') { sums[idx]++; counts[idx]++; }
        else if (activeMetric === 'Durasi') { const v=Number(d.Durasi); if(!isNaN(v)&&v>0){sums[idx]+=v;counts[idx]++;} }
        else if (activeMetric === 'Lead') { const v=Number(d.LeadTime); if(!isNaN(v)&&v>0){sums[idx]+=v;counts[idx]++;} }
        else if (activeMetric === 'SLA') { const v=Number(d.SLA); if(!isNaN(v)&&v>0){sums[idx]+=v;counts[idx]++;} }
        else if (activeMetric === 'LeadSLA') { const v=Number(d.LeadTime||0); if(!isNaN(v)){sums[idx]+=v;counts[idx]++;} }
        else if (activeMetric === 'Emisi') { sums[idx]+=Number(d.Emisi||0); counts[idx]++; }
    }
</script>
