            ['Periode: '+bulanUp+'   |   Dicetak: '+cetakTgl],
            [],
            ['A. RINGKASAN EKSEKUTIF'],
            ['Metrik','Nilai','Satuan'],
            ['Total Biaya', 'Rp '+idrDisp, 'IDR'],
