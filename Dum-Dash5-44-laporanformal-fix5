    function exportLaporanExcel() {
        const dateVal  = document.getElementById('dateInput').value;
        const selDate  = dateVal ? new Date(dateVal) : new Date();
        const bulan    = selDate.toLocaleDateString('id-ID',{month:'long',year:'numeric'});
        const bulanUp  = bulan.toUpperCase();
        const cetakTgl = new Date().toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'});
        const wb       = XLSX.utils.book_new();

        // ── Helper: buat sheet dari array of arrays ──────────────────────────
        function makeSheet(data) {
            const ws = XLSX.utils.aoa_to_sheet(data);
            return ws;
        }

        // ── Helper: set column widths ────────────────────────────────────────
        function setCols(ws, widths) {
            ws['!cols'] = widths.map(function(w){ return { wch: w }; });
        }

        // ── Hitung ulang semua data dari filteredData ────────────────────────
        let tBiaya=0, tE=0, tDur=0, cDur=0, tLead=0, cLead=0, tSLA=0, cSLA=0;
        const divRekap={}, kotaRekap={}, karyawanMap={};
        const modas={'Pesawat':0,'Kereta Api':0,'Whoosh - KCIC':0,'Bus / Travel':0,'Kend Dinas':0,'Kend Pribadi':0};
        const modaCounts={'Pesawat':0,'Kereta Api':0,'Whoosh - KCIC':0,'Bus / Travel':0,'Kend Dinas':0,'Kend Pribadi':0};
        const divPerdinMap={};

        filteredData.forEach(function(d){
            tBiaya += Number(d.BiayaIDR||0);
            tE     += Number(d.Emisi||0);
            const dur=Number(d.Durasi); if(!isNaN(dur)&&dur>0){tDur+=dur;cDur++;}
            const lead=Number(d.LeadTime); if(!isNaN(lead)&&lead>0){tLead+=lead;cLead++;}
            const sla=Number(d.SLA); if(!isNaN(sla)&&sla>0){tSLA+=sla;cSLA++;}
            if(d.Divisi) divRekap[d.Divisi]=(divRekap[d.Divisi]||0)+1;
            if(d.Kota)   kotaRekap[d.Kota]=(kotaRekap[d.Kota]||0)+1;
            if(d.Nama){
                if(!karyawanMap[d.Nama]) karyawanMap[d.Nama]={trip:0,idr:0,usd:0};
                karyawanMap[d.Nama].trip++;
                karyawanMap[d.Nama].idr+=Number(d.BiayaIDR||0);
                karyawanMap[d.Nama].usd+=Number(d.BiayaUSD||0);
            }
            const mb=(d.ModaBerangkat||'').trim();
            const mp=(d.ModaPulang||'').trim();
            if(modas[mb]!==undefined){modas[mb]+=Number(d.EmisiBerangkat||0);modaCounts[mb]++;}
            if(modas[mp]!==undefined){modas[mp]+=Number(d.EmisiPulang||0);modaCounts[mp]++;}
            if(d.Divisi){
                if(!divPerdinMap[d.Divisi]) divPerdinMap[d.Divisi]=[];
                divPerdinMap[d.Divisi].push(d);
            }
        });

        const n       = filteredData.length;
        const avgDur  = cDur>0?(tDur/cDur).toFixed(1):'0';
        const avgLead = cLead>0?(tLead/cLead).toFixed(1):'0';
        const avgSLA  = Math.round((cSLA>0?tSLA/cSLA:0)*24);
        const idrDisp = tBiaya>=1e9?(tBiaya/1e9).toFixed(2)+' Miliar':(tBiaya/1e6).toFixed(1)+' Juta';

        const divSorted   = Object.entries(divRekap).sort(function(a,b){return b[1]-a[1];});
        const kotaSorted  = Object.entries(kotaRekap).sort(function(a,b){return b[1]-a[1];});
        const karSorted   = Object.entries(karyawanMap).sort(function(a,b){return b[1].trip-a[1].trip;});
        const modaEntries = Object.entries(modas).filter(function(e){return e[1]>0;}).sort(function(a,b){return b[1]-a[1];});
        const topModa     = modaEntries[0] ? modaEntries[0][0]+' ('+Math.round(modaEntries[0][1]/tE*100)+'%)' : '-';

        function fmtIDR(v){
            if(v>=1e9) return 'Rp '+(v/1e9).toFixed(2).replace('.',',')+' Miliar';
            if(v>=1e6) return 'Rp '+(v/1e6).toFixed(1).replace('.',',')+' jt';
            if(v>=1e3) return 'Rp '+(v/1e3).toFixed(0)+' rb';
            return 'Rp '+v;
