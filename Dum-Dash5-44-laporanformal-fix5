            ['Divisi Teraktif', divSorted[0]?divSorted[0][0]+' ('+divSorted[0][1]+' trip)':'-'],
            ['Kota Terbanyak', kotaSorted[0]?kotaSorted[0][0]+' ('+kotaSorted[0][1]+' trip)':'-'],
            ['Moda Dominan', topModa],
            [],
            ['TOP 5 DIVISI PER TRIP'],
            ['Divisi','Trip'],
        ].concat(
            divSorted.slice(0,5).map(function(e){return [e[0],e[1]];})
        ).concat([
            [],
            ['TOP 5 KOTA TUJUAN'],
            ['Kota Tujuan','Trip'],
        ]).concat(
            kotaSorted.slice(0,5).map(function(e){return [e[0],e[1]];})
        ).concat([
            [],
            ['STATISTIK PERJALANAN'],
            ['Total Karyawan', karSorted.length, 'orang'],
            ['Total Divisi', divSorted.length, 'divisi'],
            ['Total Kota', kotaSorted.length, 'kota'],
            ['Emisi Total', Math.round(tE), 'kg CO2'],
            ['Avg Emisi/Trip', n>0?Math.round(tE/n):0, 'kg'],
        ]);
        const ws1 = makeSheet(ws1data);
        setCols(ws1, [35, 25, 15]);
        XLSX.utils.book_append_sheet(wb, ws1, 'Ringkasan');

        // ── SHEET 2: EMISI PER MODA ──────────────────────────────────────────
        const ws2data = [
            ['B. RINCIAN EMISI PER MODA TRANSPORTASI'],
            ['Periode: '+bulanUp],
            [],
            ['Moda Transportasi','Jumlah (kali)','Emisi (kg CO2)','Proporsi (%)'],
        ].concat(
            modaEntries.map(function(e){
                return [e[0], modaCounts[e[0]]||0, Math.round(e[1]), Math.round(e[1]/tE*100)+'%'];
            })
        ).concat([
            ['TOTAL', '', Math.round(tE), '100%'],
        ]);
        const ws2 = makeSheet(ws2data);
        setCols(ws2, [25, 15, 20, 15]);
        XLSX.utils.book_append_sheet(wb, ws2, 'Emisi per Moda');

        // ── SHEET 3: REKAP DIVISI ────────────────────────────────────────────
        const ws3data = [
            ['C. REKAP TRIP PER DIVISI'],
            ['Periode: '+bulanUp],
            [],
            ['Divisi','Trip'],
        ].concat(
            divSorted.map(function(e){return [e[0],e[1]];})
        ).concat([
            ['TOTAL', n],
        ]);
        const ws3 = makeSheet(ws3data);
        setCols(ws3, [20, 10]);
        XLSX.utils.book_append_sheet(wb, ws3, 'Rekap Divisi');

        // ── SHEET 4: REKAP KOTA ──────────────────────────────────────────────
        const ws4data = [
            ['D. REKAP TRIP PER KOTA'],
            ['Periode: '+bulanUp],
            [],
            ['Kota Tujuan','Trip'],
        ].concat(
            kotaSorted.map(function(e){return [e[0],e[1]];})
        ).concat([
            ['TOTAL', n],
        ]);
        const ws4 = makeSheet(ws4data);
        setCols(ws4, [25, 10]);
        XLSX.utils.book_append_sheet(wb, ws4, 'Rekap Kota');

        // ── SHEET 5: REKAPITULASI KARYAWAN ───────────────────────────────────
        const ws5data = [
            ['E. REKAPITULASI BIAYA PER KARYAWAN'],
            ['Periode: '+bulanUp],
            [],
            ['Nama Karyawan','Trip','Total IDR','Total USD'],
        ].concat(
            karSorted.map(function(e){
                const nm=e[0]; const v=e[1];
                return [nm, v.trip, v.idr>0?fmtIDR(v.idr):'-', v.usd>0?'$ '+v.usd:'-'];
            })
        );
        const ws5 = makeSheet(ws5data);
        setCols(ws5, [30, 8, 15, 12]);
        XLSX.utils.book_append_sheet(wb, ws5, 'Rekapitulasi Karyawan');

        // ── SHEET 6: LAMPIRAN DETAIL SPD ────────────────────────────────────
        const divPerdinSorted = Object.keys(divPerdinMap).sort(function(a,b){
            return divPerdinMap[b].length-divPerdinMap[a].length;
