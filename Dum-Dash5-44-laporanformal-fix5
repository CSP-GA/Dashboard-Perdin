    // ── Format emisi — 1 desimal untuk nilai kecil ────────────────────────────────
    function fmtEmisi(val) {
        if (val === 0) return '0';
        if (val >= 1000) return Math.round(val).toLocaleString('id-ID');
        // Hindari floating point error: bulatkan ke 1 desimal dulu
        const rounded = Math.round(val * 10) / 10;
        return rounded % 1 === 0 ? rounded.toString() : rounded.toFixed(1);
    }

    // ── Donut Chart — 140px + % tengah besar + legend ────────────────────────────
    function updateDonutChart(modas) {
        const ctx = document.getElementById('modasChart').getContext('2d');
        if (modasChart) modasChart.destroy();

        const vals   = [modas['Pesawat'], modas['Kereta Api'], modas['Whoosh - KCIC'], modas['Bus / Travel'], modas['Kend Dinas'] + modas['Kend Pribadi']];
        const total  = vals.reduce((a,b) => a+b, 0);
        const labels = ['Pesawat','Kereta Api','Whoosh','Bus/Travel','Kend.Bensin'];
        const colors = ['#ef4444','#3b82f6','#f97316','#22c55e','#64748b'];

        const maxIdx   = vals.indexOf(Math.max(...vals));
        const maxPct   = total > 0 ? Math.round((vals[maxIdx] / total) * 100) : 0;
        const maxLabel = labels[maxIdx];

        document.getElementById('donutCenter').style.display = 'block';
        document.getElementById('donutPct').innerText        = maxPct + '%';
        document.getElementById('donutLabel').innerText      = maxLabel;
        document.getElementById('donutLegend').style.display = 'flex';

        modasChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels,
                datasets: [{ data: vals, backgroundColor: colors, borderWidth: 0, hoverOffset: 4 }]
            },
            options: {
                responsive: false,
                maintainAspectRatio: false,
                cutout: '60%',
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: {
                        label: ctx => ctx.label + ': ' + fmtEmisi(ctx.raw) + ' kg (' + (total > 0 ? Math.round(ctx.raw/total*100) : 0) + '%)'
                    }}
                }
            }
        });
    }

