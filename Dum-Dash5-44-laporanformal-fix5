<script>
    let allData = [], currentMode = 'mtd', map, markers = [], trendChart, modasChart, activeMetric = null;
    let kotaData = [], filteredData = [], travelerData = [];
    let activeDrawerRow = null;
    let kotaFilter = '';
    let travelerFilter = '';
    let quickFilterType = '';
    let baseFilteredData = []; // data setelah filter periode+grup+divisi, sebelum quick filter
    let quickFilterValue = '';

    // ── Faktor emisi (mirror dari Code.gs) ──────────────────────────────────────
    const EMISSION_FACTOR = {
        'Pesawat': 0.255, 'Kereta Api': 0.041, 'Whoosh - KCIC': 0.006,
        'Bus / Travel': 0.089, 'Kend Dinas': 0.167, 'Kend Pribadi': 0.167
    };

    // ── Warna moda untuk marker peta — poin 7 ────────────────────────────────────
    const MODA_COLOR = {
        'Pesawat': '#ef4444', 'Kereta Api': '#3b82f6', 'Whoosh - KCIC': '#f97316',
        'Bus / Travel': '#22c55e', 'Kend Dinas': '#64748b', 'Kend Pribadi': '#94a3b8'
    };

    window.onload = function() {
        map = L.map('map', { zoomControl: false }).setView([-2.5489, 118.0149], 5);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {maxZoom:18, attribution:''}).addTo(map);
        document.getElementById('dateInput').value = new Date().toISOString().split('T')[0];
        google.script.run
            .withSuccessHandler(data => {
                allData = typeof data === 'string' ? JSON.parse(data) : data;
                patchLeadStatus(allData); // patch LeadStatus dari TglSubmit+Arrival
                populateDivisi();
                updateGrupStyle();
                updateDashboard();
                resetTrendHeader();
            })
            .withFailureHandler(err => {
                console.error('GAS Error:', err);
            })
            .getSheetData();
    };

    function handleDateChange() {
        quickFilterType=''; quickFilterValue='';
        document.getElementById('filterBanner').style.display='none';
        updateDashboard();
    }

    function setMode(m) {
        currentMode = m;
        ['modeDaily','modeMTD','modeYTD'].forEach(id => {
            const active = id.toLowerCase().includes(m);
            document.getElementById(id).className = 'px-6 py-2.5 rounded-lg font-black text-sm transition ' + (active ? 'bg-black text-white' : 'text-slate-400');
        });
        updateDashboard();
        // ── Stale narasi check ────────────────────────────────────────────────────
        if (narasiVisible && narasiCache) {
            const currentKey = getNarasiFilterKey();
            if (narasiCache.filterKey !== currentKey) {
                const dateVal = document.getElementById('dateInput').value;
                const selDate = dateVal ? new Date(dateVal) : new Date();
                const selDiv  = document.getElementById('filterDivisi').value;
                const selGrup = document.getElementById('filterGrup').value;
                const grupLabel = selGrup === 'PII' ? 'PII' : selGrup === 'TAD' ? 'TAD' : 'Semua';
                const lbl = selDate.toLocaleDateString('id-ID',{month:'short',year:'numeric'}) + ' · ' + grupLabel + (selDiv ? ' · '+selDiv : '');
                updateStaleBanner(true, lbl);
            }
        }
    }

const TAD_DIVISI = new Set([
        'Driver','Security','Cleaning Service','Office Boy','Resepsionis',
        'Admin COS','Admin CSF','Admin IB','Admin Ops','Admin Secr',
        'FO','GS','GS Bank','ITS','Kurir'
    ]);

    function isDivisiTAD(div) {
        if (!div) return false;
        const d = div.trim();
        for (const t of TAD_DIVISI) {
            if (d.toLowerCase() === t.toLowerCase()) return true;
        }
        return false;
    }

    function populateDivisi() {
        const grup = document.getElementById('filterGrup').value;
        const sel  = document.getElementById('filterDivisi');
        const cur  = sel.value;

        // Filter divisi berdasarkan grup
        let divs = [...new Set(allData.map(d => d.Divisi))].filter(Boolean).sort();
        if (grup === 'PII')  divs = divs.filter(d => !isDivisiTAD(d));
        if (grup === 'TAD')  divs = divs.filter(d => isDivisiTAD(d));

        const label = grup === 'PII' ? 'ALL PII'
                    : grup === 'TAD' ? 'ALL TAD'
                    : 'ALL DIVISI';
        sel.innerHTML = '<option value="">' + (label) + '</option>';
        divs.forEach(v => { sel.innerHTML += '<option value="' + (v) + '">' + (v.toUpperCase()) + '</option>'; });

        // Pertahankan pilihan sebelumnya kalau masih valid
        if (cur && divs.includes(cur)) sel.value = cur;

        // Update warna filter
        updateGrupStyle();
    }

    function handleGrupChange() {
        populateDivisi();
        // Reset divisi ke "semua" saat ganti grup
        document.getElementById('filterDivisi').value = '';
        quickFilterType = ''; quickFilterValue = '';
        document.getElementById('filterBanner').style.display = 'none';
        updateDashboard();
    }

    function updateGrupStyle() {
        const grup = document.getElementById('filterGrup').value;
        const gEl  = document.getElementById('filterGrup');
        const dEl  = document.getElementById('filterDivisi');
        if (grup === 'PII') {
            gEl.style.background = '#eff6ff'; gEl.style.borderColor = '#93c5fd'; gEl.style.color = '#1d4ed8';
            dEl.style.background = '#eff6ff'; dEl.style.borderColor = '#93c5fd'; dEl.style.color = '#1d4ed8';
        } else if (grup === 'TAD') {
            gEl.style.background = '#faf5ff'; gEl.style.borderColor = '#c4b5fd'; gEl.style.color = '#6d28d9';
            dEl.style.background = '#faf5ff'; dEl.style.borderColor = '#c4b5fd'; dEl.style.color = '#6d28d9';
        } else {
            gEl.style.background = ''; gEl.style.borderColor = ''; gEl.style.color = '';
            dEl.style.background = ''; dEl.style.borderColor = ''; dEl.style.color = '';
        }
    }

    // ── Format angka Indonesia ────────────────────────────────────────────────────
    function fmtIDR(val) {
        if (val >= 1000000000) return (val/1000000000).toFixed(2).replace('.',',') + ' Miliar';
        if (val >= 1000000)    return (val/1000000).toFixed(1).replace('.',',') + ' Juta';
        if (val >= 1000)       return (val/1000).toFixed(0) + ' Rb';
        return val.toFixed(0);
    }
    function fmtIDR_compact(val) {
        if (val >= 1000000000) return (val/1000000000).toFixed(2).replace('.',',') + ' M';
        if (val >= 1000000)    return (val/1000000).toFixed(1).replace('.',',') + ' jt';
        if (val >= 1000)       return (val/1000).toFixed(0) + ' rb';
        return val.toFixed(0);
    }

    function fmtNum(val) {
        return Math.round(val).toLocaleString('id-ID');
    }


    // ── Format Lead Time — pakai selisih hari kalender ──────────────────────────
    function fmtLeadTime(val) {
        if (!val || val <= 0) return { val: '0', unit: 'hari' };
        return { val: val.toFixed(0), unit: val <= 1 ? 'hari' : 'hari' };
    }

    // ── Hitung LeadStatus dari data individual (untuk avg) ───────────────────────
    function getLeadStatusFromAvg(avgLead, data) {
        // Cek distribusi status dari filteredData
        let nSangatMepet = 0, nMepet = 0, nInfo = 0, nNormal = 0;
        data.forEach(d => {
            const s = d.LeadStatus || 'normal';
            if (s === 'sangat_mepet') nSangatMepet++;
            else if (s === 'mepet') nMepet++;
            else if (s === 'info') nInfo++;
            else nNormal++;
        });
        if (nSangatMepet > 0) return 'sangat_mepet';
        if (nMepet > 0) return 'mepet';
        if (nInfo > 0) return 'info';
        return 'normal';
    }

    function updateDashboard() {
        const selDate = new Date(document.getElementById('dateInput').value);
        const selDiv  = document.getElementById('filterDivisi').value;
        const selGrup = document.getElementById('filterGrup').value;

        const filtered = allData.filter(d => {
            const arr = new Date(d.Arrival);
            let matchTime = false;
            if (currentMode === 'daily') matchTime = arr.toDateString() === selDate.toDateString();
            else if (currentMode === 'mtd') matchTime = arr.getMonth() === selDate.getMonth() && arr.getFullYear() === selDate.getFullYear() && arr <= selDate;
            else matchTime = arr.getFullYear() === selDate.getFullYear() && arr <= selDate;

            let matchGrup = true;
            if (selGrup === 'PII') matchGrup = !isDivisiTAD(d.Divisi);
            if (selGrup === 'TAD') matchGrup = isDivisiTAD(d.Divisi);

            return matchTime && matchGrup && (selDiv === '' || d.Divisi === selDiv);
        });

        // ── Quick filter (traveler / kota) ────────────────────────────────────────
        const display = quickFilterType === 'traveler'
            ? filtered.filter(d => d.Nama === quickFilterValue)
            : quickFilterType === 'kota'
            ? filtered.filter(d => d.Kota && d.Kota.toLowerCase().includes(quickFilterValue.toLowerCase()))
            : filtered;

        baseFilteredData = filtered; // simpan sebelum quick filter
        filteredData = display; // simpan global termasuk quick filter untuk chart

        const n = display.length;
        let tBiayaIDR = 0, tBiayaUSD = 0, tE = 0, tDurasi = 0, tLead = 0, tSLA = 0;
        let cDurasi = 0, cLead = 0, cSLA = 0;
        const modas = { 'Pesawat':0, 'Kereta Api':0, 'Whoosh - KCIC':0, 'Bus / Travel':0, 'Kend Dinas':0, 'Kend Pribadi':0 };

        display.forEach(d => {
            tBiayaIDR += Number(d.BiayaIDR || 0);
            tBiayaUSD += Number(d.BiayaUSD || 0);
            tE += Number(d.Emisi || 0);
            const dur = Number(d.Durasi); if (!isNaN(dur) && dur > 0) { tDurasi += dur; cDurasi++; }
            const lead = Number(d.LeadTime); if (!isNaN(lead) && lead > 0) { tLead += lead; cLead++; }
            const sla = Number(d.SLA); if (!isNaN(sla) && sla > 0) { tSLA += sla; cSLA++; }
            const mb = (d.ModaBerangkat || '').trim();
            const mp = (d.ModaPulang    || '').trim();
            if (modas[mb] !== undefined) modas[mb] += Number(d.EmisiBerangkat || 0);
            if (modas[mp] !== undefined) modas[mp] += Number(d.EmisiPulang    || 0);
        });

        const avgDurasi = cDurasi > 0 ? tDurasi/cDurasi : 0;
        const avgLead   = cLead   > 0 ? tLead/cLead     : 0;
        const avgSLA    = cSLA    > 0 ? tSLA/cSLA        : 0;

        // Cards
        const idrJuta = tBiayaIDR / 1000000;
        const idrDisplay = tBiayaIDR >= 1000000000
            ? (tBiayaIDR/1000000000).toFixed(2).replace('.',',')
            : idrJuta.toFixed(1).replace('.',',');
        const idrUnit = tBiayaIDR >= 1000000000 ? 'Miliar IDR' : 'juta IDR';
        document.getElementById('valBiayaIDR').innerText = idrDisplay;
        document.getElementById('unitBiayaIDR').innerText = idrUnit;
        document.getElementById('valBiayaUSD').innerText = '$' + fmtNum(tBiayaUSD);
        document.getElementById('valTrip').innerText     = n;
        document.getElementById('valDurasi').innerText   = avgDurasi.toFixed(1);
        // Lead time + SLA — format & warna kondisi
        const leadFmt    = fmtLeadTime(avgLead);
        const leadStatus = getLeadStatusFromAvg(avgLead, display);
        document.getElementById('valLead').innerText  = leadFmt.val;
        document.getElementById('unitLead').innerText = leadFmt.unit;
        // SLA dalam jam (avgSLA dalam hari kalender × 24)
        const avgSLAJam = Math.round(avgSLA * 24);
        document.getElementById('valSLA').innerText = avgSLAJam;
        document.getElementById('valEmisi').innerText = fmtNum(tE);

        const cardLead = document.getElementById('card-LeadSLA');
        const valLead  = document.getElementById('valLead');
        const warnLead = document.getElementById('warnLead');
        const warnSLA  = document.getElementById('warnSLA');
        const unitSLA  = document.getElementById('unitSLA');
        const valSLAEl = document.getElementById('valSLA');
        const slaLambat = avgSLAJam > 8; // > 8 jam = lambat

        // Reset
        cardLead.className = 'metric-card bg-slate-900 border-t-yellow-400';
        valLead.style.color = 'white';

        // Lead time status
        // Hitung % sangat_mepet
        const nSameDayTrips = baseFilteredData.filter(d => d.LeadStatus === 'sangat_mepet').length;
        const pctSameDay = baseFilteredData.length > 0 ? Math.round(nSameDayTrips / baseFilteredData.length * 100) : 0;

        const leadWarnMap = {
            'sangat_mepet': { color:'#ef4444', text: pctSameDay + '% submit hari yang sama' },
            'mepet':        { color:'#f97316', text:'&#9888; di luar jam kerja' },
            'info':         { color:'#fbbf24', text:'ℹ di luar jam kerja' },
            'normal':       { color:'white',   text:'' }
        };
        const lw = leadWarnMap[leadStatus] || leadWarnMap['normal'];
        valLead.style.color = lw.color;
        if (lw.text) {
            warnLead.innerHTML = leadStatus === 'sangat_mepet' && nSameDayTrips > 0
                ? '<span onclick="showSameDayTrips()" style="cursor:pointer;text-decoration:underline;font-size:11px;line-height:1.4;">' + lw.text + '</span>'
                : '<span style="font-size:11px;line-height:1.4;">' + lw.text + '</span>';
            warnLead.style.display = 'block';
        } else {
            warnLead.style.display = 'none';
        }

        // SLA warning
        if (slaLambat) {
            valSLAEl.style.color = '#f97316';
            unitSLA.style.color  = '#f97316';
            unitSLA.innerText = 'Jam';
            warnSLA.innerHTML = '<span style="font-size:11px;line-height:1.4;">&#9888; lambat · threshold 8 jam</span>';
            warnSLA.style.display = 'block';
        } else {
            valSLAEl.style.color = '#8b5cf6';
            unitSLA.style.color  = '#64748b';
            unitSLA.innerText = 'Jam';
            warnSLA.style.display = 'none';
        }

        // Border card
        if (leadStatus === 'sangat_mepet') {
            cardLead.className = 'metric-card bg-slate-900 border-t-red-500';
        } else if (leadStatus === 'mepet' || slaLambat) {
            cardLead.className = 'metric-card bg-slate-900 border-t-orange-500';
        } else if (leadStatus === 'info') {
            cardLead.className = 'metric-card bg-slate-900 border-t-yellow-400';
        }

        // Emisi legend
        document.getElementById('emPesawat').innerText    = fmtNum(modas['Pesawat']);
        document.getElementById('emKereta').innerText     = fmtNum(modas['Kereta Api']);
        document.getElementById('emWhoosh').innerText     = fmtNum(modas['Whoosh - KCIC']);
        document.getElementById('emBus').innerText        = fmtNum(modas['Bus / Travel']);
        document.getElementById('emKendDinas').innerText  = fmtNum(modas['Kend Dinas']) + ' kg';
        document.getElementById('emKendPribadi').innerText= fmtNum(modas['Kend Pribadi']) + ' kg';
        document.getElementById('emKendTotal').innerText  = fmtNum(modas['Kend Dinas'] + modas['Kend Pribadi']);
        document.getElementById('emTotal').innerText      = fmtNum(tE);

        // Donut
        if (tE > 0) {
            document.getElementById('modasChart').style.display = 'block';
            document.getElementById('noDataText').style.display = 'none';
            updateDonutChart(modas);
        } else {
            document.getElementById('modasChart').style.display = 'none';
            document.getElementById('noDataText').style.display = 'block';
            document.getElementById('donutCenter').style.display = 'none';
            document.getElementById('donutLegend').style.display = 'none';
        }

        // Top Travelers — dari filtered (semua, bukan display) agar list tidak berubah saat filter aktif
        const counts = {};
        filtered.forEach(d => { counts[d.Nama] = (counts[d.Nama] || 0) + 1; });
        travelerData = Object.entries(counts).sort((a,b) => b[1]-a[1]); // semua, tanpa batas
        renderTravelerList(travelerData);

        // Top Kota — dari filtered agar list tidak berubah saat filter aktif
        const kotaCounts = {};
        filtered.forEach(d => {
            if (!d.Kota) return;
            if (!kotaCounts[d.Kota]) kotaCounts[d.Kota] = { trip:0, emisi:0, jarak:d.Jarak||0 };
            kotaCounts[d.Kota].trip++;
            kotaCounts[d.Kota].emisi += Number(d.Emisi||0);
        });
        kotaData = Object.entries(kotaCounts).sort((a,b) => b[1].trip-a[1].trip);
        renderKotaList(kotaData);

        // Tabel
        kotaFilter = '';
        travelerFilter = '';
        renderTabel(display);

        // Map markers — dari display
        markers.forEach(m => map.removeLayer(m));
        markers = [];
        const cityGroup = {};
        display.forEach(d => {
            if (d.Lat !== null && d.Lng !== null && d.Lat !== undefined && d.Lng !== undefined) {
                if (!cityGroup[d.Kota]) cityGroup[d.Kota] = [];
                cityGroup[d.Kota].push(d);
            }
        });
        Object.keys(cityGroup).forEach(k => {
            const items = cityGroup[k];
            const f = items[0];
            const count = items.length;
            const totalEmisiKota = items.reduce((s,d) => s + Number(d.Emisi||0), 0);
            const totalBiayaKota = items.reduce((s,d) => s + Number(d.BiayaIDR||0), 0);

            // Hitung moda dominan
            const modaCount = {};
            items.forEach(d => { const m = d.ModaBerangkat||''; modaCount[m] = (modaCount[m]||0)+1; });
            const modaDominan = Object.entries(modaCount).sort((a,b) => b[1]-a[1])[0]?.[0] || '';
            const markerColor = MODA_COLOR[modaDominan] || '#3b82f6';

            const r = Math.min(8 + count*1.5, 22);
            const isActive = quickFilterType === 'kota' && quickFilterValue === k;
            const marker = L.circleMarker([f.Lat, f.Lng], {
                color: isActive ? '#1d4ed8' : '#fff',
                weight: isActive ? 3 : 2,
                fillColor: markerColor,
                fillOpacity: 0.85,
                radius: r
            }).bindPopup('\n                <div style="font-family:\'Inter\',\'Segoe UI\',sans-serif;min-width:160px;padding:2px 0;">\n                    <div style="font-size:13px;font-weight:800;color:#0f172a;margin-bottom:4px;">' + (k) + '</div>\n                    <div style="font-size:11px;color:#64748b;margin-bottom:2px;">' + (count) + ' trip &nbsp;·&nbsp; ' + (fmtNum(f.Jarak||0)) + ' km</div>\n                    <div style="font-size:11px;color:#64748b;margin-bottom:2px;">Moda: ' + (modaDominan) + '</div>\n                    <div style="font-size:11px;color:#dc2626;margin-bottom:8px;">Emisi: ' + (fmtEmisi(totalEmisiKota)) + ' kg CO₂</div>\n                    <div style="font-size:11px;color:#2563eb;margin-bottom:8px;">Biaya: Rp ' + (fmtIDR(totalBiayaKota)) + '</div>\n                    <button onclick="setQuickFilter(\'kota\',\'' + (k.replace(/'/g,"\\'")) + '\');document.querySelector(\'.leaflet-popup-close-button\')?.click();"\n                        style="width:100%;background:#2563eb;color:white;border:none;border-radius:6px;padding:6px 0;font-size:11px;font-weight:700;cursor:pointer;">\n                        Filter Dashboard\n                    </button>\n                </div>\n            ', { maxWidth: 200 }).addTo(map);
            markers.push(marker);
        });

        if (activeMetric) updateTrendChart(getActiveColor());
        else resetTrendHeader();
    }

