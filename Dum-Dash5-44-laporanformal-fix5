    // ── Hitung LeadStatus di client — tidak bergantung Code.gs ─────────────────
    function calcLeadStatus(tglSubmit, tglBerangkat) {
        if (!tglSubmit || !tglBerangkat) return 'normal';
        const s = new Date(tglSubmit);
        const b = new Date(tglBerangkat);
        if (isNaN(s) || isNaN(b)) return 'normal';

        const sDate = new Date(s.getFullYear(), s.getMonth(), s.getDate());
        const bDate = new Date(b.getFullYear(), b.getMonth(), b.getDate());

        // Hari yang sama
        if (sDate.getTime() === bDate.getTime()) return 'sangat_mepet';

        // Submit di luar jam kerja?
        const hariSubmit = s.getDay();
        const jamSubmit  = s.getHours() + s.getMinutes()/60;
        const diLuar = (hariSubmit === 0 || hariSubmit === 6) || (jamSubmit < 8 || jamSubmit >= 17);

        if (diLuar) {
            // Hitung hari kerja tersisa
            let cur = new Date(sDate); cur.setDate(cur.getDate()+1);
            let hkTersisa = 0;
            while (cur < bDate) {
                if (cur.getDay() !== 0 && cur.getDay() !== 6) hkTersisa++;
                cur.setDate(cur.getDate()+1);
            }
            if (bDate.getDay() !== 0 && bDate.getDay() !== 6) hkTersisa++;
            return hkTersisa === 0 ? 'mepet' : 'info';
        }
        return 'normal';
    }

    // Patch LeadStatus di allData setelah load
    function patchLeadStatus(data) {
        data.forEach(function(d) {
            if (!d.LeadStatus || d.LeadStatus === 'normal') {
                const calc = calcLeadStatus(d.TglSubmit, d.Arrival);
                if (calc !== 'normal') d.LeadStatus = calc;
            }
        });
    }

        // ── Build enriched narasi payload ─────────────────────────────────────────────
    function buildNarasiPayload(data, mode, selDate) {
        const modeLabel = { daily:'Harian', mtd:'MTD', ytd:'YTD' };
        const n = data.length;
        let tBiayaIDR=0, tE=0, tLead=0, tDur=0, tSLA=0, cLead=0, cDur=0, cSLA=0;
        const modaCounts = {}, modaKg = {};
        const proyekMap = {}, proyekDivisi = {};
        const divCounts = {};

        data.forEach(d => {
            tBiayaIDR += Number(d.BiayaIDR||0);
            tE        += Number(d.Emisi||0);
            if (d.LeadTime > 0) { tLead += Number(d.LeadTime||0); cLead++; }
            if (d.Durasi  > 0) { tDur  += Number(d.Durasi||0);  cDur++;  }
            if (d.SLA     > 0) { tSLA  += Number(d.SLA||0);     cSLA++;  }

            // Moda — berangkat + pulang
            [d.ModaBerangkat, d.ModaPulang].forEach(m => {
                if (!m) return;
                modaCounts[m] = (modaCounts[m]||0) + 1;
                modaKg[m]     = (modaKg[m]||0) + Number(d.Emisi||0)/2;
            });

            // Divisi
            if (d.Divisi) divCounts[d.Divisi] = (divCounts[d.Divisi]||0) + 1;

            // Proyek
            const proj = (d.Tujuan||'').trim();
            if (proj && proj !== '-') {
                proyekMap[proj]    = (proyekMap[proj]||0) + 1;
                if (!proyekDivisi[proj]) proyekDivisi[proj] = new Set();
                proyekDivisi[proj].add(d.Divisi||'');
            }
        });

        // Top proyek sorted by trip
        const allProyekArr = Object.keys(proyekMap)
            .map(k => ({ nama:k, divisi:[...proyekDivisi[k]].filter(Boolean).join(' · '), trip:proyekMap[k] }))
            .sort((a,b) => b.trip - a.trip);
        const topProyek = allProyekArr.slice(0,3);

        // Moda data
        const totalEmisi = tE || 1;
        const modaData = Object.keys(modaKg)
            .map(m => ({
                nama: m,
                kg: Math.round(modaKg[m]),
                pct: Math.round(modaKg[m]/totalEmisi*100),
                times: modaCounts[m]||0
            }))
            .sort((a,b) => b.kg - a.kg);

        const topDivisi = Object.entries(divCounts)
            .sort((a,b) => b[1]-a[1])
            .slice(0,10)
            .map(([nama,trip]) => ({nama, trip}));

        return {
            n,
            tBiayaIDR: Math.round(tBiayaIDR/1e6*10)/10,
            tE: Math.round(tE),
            avgDur:  cDur  > 0 ? Math.round(tDur/cDur*10)/10  : 0,
            avgLead: cLead > 0 ? Math.round(tLead/cLead*10)/10 : 0,
            avgSLA:  cSLA  > 0 ? Math.round(tSLA/cSLA*10)/10   : 0,
            periode: (modeLabel[mode]||'') + ' ' + selDate.toLocaleDateString('id-ID',{month:'long',year:'numeric'}),
            tujuanList: data.map(d=>d.Tujuan).filter(Boolean).slice(0,100),
            topProyek,
            allProyek: allProyekArr,
            modaData,
            topDivisi
        };
    }

    // ── Parse structured narasi response ──────────────────────────────────────────
    function parseNarasiResponse(text, fallbackPayload) {
        const get = (tag) => {
            const m = text.match(new RegExp('\\['+tag+'\\]([\\s\\S]*?)(?=\\[|$)','i'));
            return m ? m[1].trim() : '';
        };
        const umum = get('UMUM');

        // Parse PROYEK_JSON — coba berbagai format
        let proyekList = [];
        const proyekRaw = get('PROYEK_JSON');
        if (proyekRaw) {
            // Coba match JSON array
            const jsonMatch = proyekRaw.match(/\[[\s\S]*\]/);
            if (jsonMatch) {
                try { proyekList = JSON.parse(jsonMatch[0]); } catch(e) {}
            }
        }
        // Fallback: pakai allProyek dari payload — filter hanya yang mengandung "proyek/project"
        if (proyekList.length === 0 && fallbackPayload && fallbackPayload.allProyek) {
            proyekList = fallbackPayload.allProyek
                .filter(function(p) {
                    return /proyek|project/i.test(p.nama||'');
                })
                .slice(0,10)
                .map(function(p) {
                    return { nama: p.nama, divisi: p.divisi, trip: p.trip };
                });
        }

        // Parse SUSTAINABILITY — paragraf dulu, lalu JSON array moda
        const sustRaw = get('SUSTAINABILITY');
        let modaList = [];
        // Ambil paragraf = teks SEBELUM JSON array pertama
        const jsonStartIdx = sustRaw.indexOf('[');
        const sustPara = jsonStartIdx > 0 ? sustRaw.substring(0, jsonStartIdx).trim() : sustRaw.trim();
        // Ambil JSON array
        const modaMatch = sustRaw.match(/\[[\s\S]*\]/);
        if (modaMatch) { try { modaList = JSON.parse(modaMatch[0]); } catch(e) {} }
        // Fallback: pakai modaData dari payload
        if (modaList.length === 0 && fallbackPayload && fallbackPayload.modaData) {
            modaList = fallbackPayload.modaData;
        }

        return { umum, proyekList, sustPara, modaList };
    }

